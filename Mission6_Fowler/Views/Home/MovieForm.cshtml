<!-- Nav Bar -->
@model Form
@{
    ViewData["Title"] = "Add Movie";
}

<!-- Form to add movie, the required columns are marked, and asp-for calls the variable from the model -->
<title>Movie Form</title>
<form method="post">
    <label asp-for="Title">Movie Name</label>
    <input asp-for="Title" required></input>
    <br/><br/>
    <label asp-for="CategoryId">Category</label>
    <select asp-for="CategoryId">
        @foreach (Categories m in ViewBag.Category)
        {
            <option value="@m.CategoryId">@m.CategoryName</option>
        }
    </select>
    <br/><br/>
    <label asp-for="Year">Year</label>
    <input asp-for="Year" required></input>
    <br/><br/>
    <label asp-for="Director">Director</label>
    <input asp-for="Director" required></input>
    <br/><br/>
    <label asp-for="Rating">Rating</label>
    <select asp-for="Rating">
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="13">PG-13</option>
        <option value="R">R</option>
    </select>
    <br/><br/>
    <label asp-for="Edited">Edited</label><br/>
    <input type="radio" asp-for="Edited" value="true" id="edited-true"/>
    <label for="edited-true">Yes</label>
    <input type="radio" asp-for="Edited" value="false" id="edited-false"/>
    <label for="edited-false">No</label>
    <br/><br/>
    <label asp-for="LentTo">Lent To</label>
    <input asp-for="LentTo"/>
    <br/><br/>
    <label asp-for="CopiedToPlex">Copied to Plex</label><br/>
    <input type="radio" asp-for="CopiedToPlex" value="true" id="copied-true"/>
    <label for="copied-true">Yes</label>
    <input type="radio" asp-for="CopiedToPlex" value="false" id="copied-false"/>
    <label for="copied-false">No</label>
    <br/><br/>
    <label asp-for="Notes">Notes</label>
    <input asp-for="Notes" maxlength="25">
    <br/><br/>
    <button type="submit">Add Movie</button>
</form>

